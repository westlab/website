{
  "name": "westlab-site",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && pagefind --site dist",
    "preview": "astro preview",
    "astro": "astro",
    "check:i18n": "node scripts/check-translations.mjs",
    "check:data": "node scripts/check-data-values.mjs",
    "lint": "prettier --check \"src/**/*.{md,yaml}\" && node scripts/check-headings.mjs && node scripts/check-quotes.mjs",
    "lint:headings": "node scripts/check-headings.mjs",
    "lint:quotes": "node scripts/check-quotes.mjs",
    "test": "node scripts/check-duplicate-ids.mjs && node scripts/check-page-heroes.mjs && node scripts/check-image-sizes.mjs && node scripts/check-yaml-hash.mjs && node scripts/check-frontmatter.mjs",
    "lint:fix": "prettier --write \"src/**/*.{md,yaml}\"",
    "prepare": "git config core.hooksPath .githooks",
    "compress:images": "node scripts/compress-images.mjs",
    "check": "astro check"
  },
  "dependencies": {
    "@astrojs/markdown-satteri": "^0.3.7",
    "@astrojs/sitemap": "^3.7.4",
    "astro": "^7.4.2",
    "js-yaml": "^4.3.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@types/js-yaml": "^4.0.9",
    "@types/mdast": "^4.0.4",
    "pagefind": "^1.5.2",
    "prettier": "^3.9.9",
    "satteri": "^0.10.5",
    "sharp": "^0.35.3",
    "typescript": "^6.0.3"
  }
}
