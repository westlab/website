{
  "name": "westlab-site",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && pagefind --site dist",
    "preview": "astro preview",
    "astro": "astro",
    "check:i18n": "node scripts/check-translations.mjs",
    "check:data": "node scripts/check-data-values.mjs",
    "lint": "prettier --check \"src/**/*.{md,yaml}\" && node scripts/check-headings.mjs && node scripts/check-quotes.mjs",
    "lint:headings": "node scripts/check-headings.mjs",
    "lint:quotes": "node scripts/check-quotes.mjs",
    "test": "node scripts/check-duplicate-ids.mjs && node scripts/check-page-heroes.mjs && node scripts/check-image-sizes.mjs",
    "lint:fix": "prettier --write \"src/**/*.{md,yaml}\"",
    "prepare": "git config core.hooksPath .githooks",
    "compress:images": "node scripts/compress-images.mjs"
  },
  "dependencies": {
    "astro": "^7.2.4",
    "js-yaml": "^4.3.0"
  },
  "devDependencies": {
    "pagefind": "^1.5.2",
    "prettier": "^3.9.9",
    "sharp": "^0.35.3"
  }
}
