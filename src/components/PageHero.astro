---
// Figma: Page Title（下層ページ上部の写真バナー。1440×470 / Mobile 375×188）
interface Props {
  title: string;
  image: string;
}

const { title, image } = Astro.props;
---

<div class="page-hero">
  <img class="photo" src={image} alt="" />
  <h1 class="t-display-page-title">{title}</h1>
</div>

<style>
  .page-hero {
    position: relative;
    display: flex;
    flex-direction: column;
    height: 470px;
    padding: 80px var(--gutter) 60px;
    overflow: hidden;
  }

  .photo {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  h1 {
    position: relative;
    margin: 0;
    color: #fff;
    text-shadow: 0 2px 10px rgba(0, 0, 0, 0.7);
  }

  @media (max-width: 767px) {
    .page-hero {
      justify-content: center;
      height: 188px;
    }
  }
</style>
