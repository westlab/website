---
// Figma: Page Title（下層ページ上部の写真バナー。1440×470 / Mobile 375×128。
// モバイルで長いタイトルが折り返す場合は最小128pxのまま下に伸びる）。
// image を渡さないページ（404）は写真の代わりに紺の単色で、高さ280px（Figma: 404 Page）。
interface Props {
  title: string;
  image?: string;
}

const { title, image } = Astro.props;
---

<div class={image ? 'page-hero' : 'page-hero plain'}>
  {image && <img class="photo" src={image} alt="" />}
  <h1 class="t-display-page-title">{title}</h1>
</div>

<style>
  .page-hero {
    position: relative;
    display: flex;
    flex-direction: column;
    height: 470px;
    padding: 80px var(--gutter) 60px;
    overflow: hidden;
  }

  .plain {
    height: 280px;
    background: var(--color-navy);
  }

  .plain h1 {
    text-shadow: none;
  }

  .photo {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  h1 {
    position: relative;
    margin: 0;
    color: #fff;
    text-shadow: 0 2px 10px rgba(0, 0, 0, 0.7);
  }

  @media (max-width: 767px) {
    .page-hero {
      height: auto;
      min-height: 128px;
      padding-top: 48px;
      padding-bottom: 32px;
    }
  }
</style>
