---
// Figma: Video Card / 動画一覧（438:932）。再生アイコン付きサムネイル、タイトル、サブタイトル。
import type { CollectionEntry } from 'astro:content';
import { t, type Lang } from '../i18n/ui';
import { getYouTubeId } from '../lib/youtube';

interface Props {
  video: CollectionEntry<'videos'>['data'];
  lang?: Lang;
}

const { video, lang = 'ja' } = Astro.props;
const videoId = getYouTubeId(video.url);
const title = lang === 'ja' ? video.title_ja : video.title_en;
// 動画なしのときはボタンにせず、アイコンだけ表示する
const Inner = videoId ? 'button' : 'div';
const innerProps = videoId ? { type: 'button', 'aria-label': `${t(lang, 'videos.play')}: ${title}` } : {};
---

<div class="video-card">
  <div class="thumbnail" data-video-id={videoId} data-title={title}>
    <Inner class:list={['inner', { 'thumb-button': videoId }]} {...innerProps}>
      {videoId && <img src={`https://i.ytimg.com/vi/${videoId}/hqdefault.jpg`} alt="" loading="lazy" />}
      <svg class="play" width="64" height="64" viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
        <circle cx="32" cy="32" r="32" fill="#fff" fill-opacity="0.92" />
        <path d="M25 19L46 32L25 45V19Z" fill="#00007B" />
      </svg>
    </Inner>
  </div>
  <h2 class="title t-h3">{title}</h2>
  <p class="description t-caption">{lang === 'ja' ? video.description_ja : video.description_en}</p>
</div>

<script>
  document.querySelectorAll<HTMLElement>('.thumbnail[data-video-id]').forEach((box) => {
    box.querySelector('button')?.addEventListener('click', () => {
      const iframe = document.createElement('iframe');
      iframe.src = `https://www.youtube-nocookie.com/embed/${box.dataset.videoId}?autoplay=1&rel=0`;
      iframe.title = box.dataset.title ?? '';
      iframe.allow = 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share';
      iframe.referrerPolicy = 'strict-origin-when-cross-origin';
      iframe.allowFullscreen = true;
      box.replaceChildren(iframe);
      // ボタンが消えるため、フォーカスをiframeへ移す
      iframe.focus();
    });
  });
</script>

<style>
  .video-card {
    display: flex;
    flex-direction: column;
    gap: 12px;
    color: inherit;
  }

  .thumbnail {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    height: 506px;
    border-radius: 8px;
    background: #171a24;
    overflow: hidden;
    transition: filter 0.2s ease;
  }

  .thumbnail[data-video-id]:hover {
    filter: brightness(1.25);
  }

  .thumbnail :global(iframe) {
    width: 100%;
    height: 100%;
    border: 0;
  }

  .inner {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
    padding: 0;
    border: 0;
    background: transparent;
  }

  .thumb-button {
    cursor: pointer;
  }

  /* :has() 非対応のブラウザではボタン自身の枠を残す */
  @supports selector(:has(*)) {
    .thumb-button:focus-visible {
      outline: none;
    }
  }

  /* overflow:hidden で切られないよう、枠は外側の .thumbnail に付ける（白+ネイビーの二重リング） */
  .thumbnail:has(.thumb-button:focus-visible) {
    outline: 3px solid var(--color-navy);
    outline-offset: 2px;
    box-shadow: 0 0 0 2px #fff;
  }

  .thumb-button img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .play {
    position: relative;
    flex: none;
  }

  .title,
  .description {
    margin: 0;
  }

  .title {
    color: var(--color-text);
  }

  .description {
    color: var(--color-text-subtle);
  }

  @media (max-width: 1023px) {
    .thumbnail {
      height: auto;
      aspect-ratio: 16 / 9;
    }
  }
</style>
