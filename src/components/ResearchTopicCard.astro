---
// Figma: Card / 研究トピック（359:521）。アイコン枠+タイトル、要約、「詳しく見る →」。
import type { CollectionEntry } from 'astro:content';
import ResearchIcon from './icons/ResearchIcon.astro';
import { t, type Lang } from '../i18n/ui';

interface Props {
  topic: CollectionEntry<'research'> & { slug: string };
  lang?: Lang;
}

const { topic, lang = 'ja' } = Astro.props;
---

<a class="topic-card" href={`/research/${topic.slug}/`}>
  <div class="header">
    <span class="icon"><ResearchIcon name={topic.data.icon as any} /></span>
    <h3 class="title t-item">{topic.data.title}</h3>
  </div>
  <p class="summary t-caption">{topic.data.summary}</p>
  <span class="more t-ui-bold">
    {t(lang, 'common.more')}
    <span class="arrow t-icon-glyph" aria-hidden="true">→</span>
  </span>
</a>

<style>
  .topic-card {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 16px;
    min-height: 252px;
    padding: 32px;
    border-radius: 16px;
    background: #f8f8fa;
    color: inherit;
    text-decoration: none;
    transition: box-shadow 0.2s ease, transform 0.2s ease;
  }

  .topic-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(0, 0, 123, 0.12);
  }

  .header {
    display: flex;
    align-items: flex-start;
    gap: 16px;
  }

  .icon {
    display: flex;
    align-items: center;
    justify-content: center;
    flex: none;
    width: 48px;
    height: 48px;
    border-radius: 12px;
    background: var(--color-navy);
    color: #fff;
  }

  .title {
    flex: 1;
    min-width: 0;
    margin: 0;
    color: var(--color-text);
  }

  .summary {
    margin: 0;
    color: var(--color-text-muted);
  }

  .more {
    display: flex;
    align-items: center;
    gap: 6px;
    color: var(--color-navy);
  }

  @media (max-width: 767px) {
    .topic-card {
      min-height: 210px;
      padding: 20px;
    }

    .header {
      gap: 8px;
    }

    /* モバイルでは Caption/Label と同じサイズ */
    .title {
      font-size: var(--type-caption-label-size);
      line-height: var(--type-caption-label-leading);
    }
  }
</style>
