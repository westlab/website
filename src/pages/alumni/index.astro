---
import { getCollection } from 'astro:content';
import SubPageLayout from '../../layouts/SubPageLayout.astro';
import { getPageImage } from '../../lib/pages';
import { getSite } from '../../lib/site';
import { t } from '../../i18n/ui';

const lang = 'ja' as const;
const title = t(lang, 'nav.members.alumni');
const image = await getPageImage('alumni');

const site = await getSite();
const cohorts = (await getCollection('alumni')).sort((a, b) => b.data.cohort - a.data.cohort);
---

<SubPageLayout title={title} description={site.page_descriptions.alumni.ja} image={image} lang={lang} maxWidth="none" gap={48} mobileGap={32}>
  {cohorts.map((entry) => (
    <div class="cohort">
      <h2 class="t-section">{entry.data.cohort}期</h2>
      <hr class="divider" />
      <ul class="names">
        {entry.data.names.map((person) => (
          <li class="name t-emphasis">{person.name_ja}</li>
        ))}
      </ul>
    </div>
  ))}
</SubPageLayout>

<style>
  .cohort {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .cohort h2 {
    margin: 0;
    color: var(--color-blue-medium);
  }

  .divider {
    width: 100%;
    height: 1px;
    margin: 0;
    border: 0;
    background: var(--color-border);
  }

  .names {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 12px 24px;
  }

  .name {
    width: 180px;
    color: var(--color-text);
  }

  @media (max-width: 767px) {
    .cohort {
      gap: 16px;
    }

    .names {
      flex-direction: column;
      gap: 8px;
    }

    .name {
      width: auto;
    }
  }
</style>
