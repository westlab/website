---
// Figma: 404 Page / 404 Page (Mobile)。パンくず + 見出し(H1) + 案内文 + リンク2つ。
// 存在しない URL でサーバーが返す。検索インデックスと検索エンジンの対象外。
import BaseLayout from '../layouts/BaseLayout.astro';
import PageContent from '../components/PageContent.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import { t } from '../i18n/ui';

const lang = 'ja' as const;
const title = t(lang, 'notfound.title');
---

<BaseLayout title={title} description={t(lang, 'notfound.lead')} lang={lang} indexable={false}>
  <PageContent clip mobileBottom={48}>
    <Breadcrumb lang={lang} current={{ label: title, href: '/404/' }} />
    <h1 class="t-section">{title}</h1>
    <div class="body">
      <p class="t-body">{t(lang, 'notfound.lead')}</p>
      <ul class="t-ui">
        <li><a href="/">{t(lang, 'notfound.home')}</a></li>
        <li><a href="/search/">{t(lang, 'notfound.search')}</a></li>
      </ul>
    </div>
  </PageContent>
</BaseLayout>

<style>
  /* Figma: 404 Page / Content */
  .body {
    display: flex;
    flex-direction: column;
    gap: 32px;
  }

  h1 {
    margin: 0 0 24px;
    color: var(--color-navy);
  }

  p {
    margin: 0;
  }

  ul {
    display: flex;
    flex-wrap: wrap;
    gap: 16px 32px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  a {
    color: var(--color-navy);
    text-decoration: underline;
  }

  @media (max-width: 767px) {
    ul {
      flex-direction: column;
    }
  }
</style>
