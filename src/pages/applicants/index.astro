---
import SubPageLayout from '../../layouts/SubPageLayout.astro';
import { getNavPage, navPageProps } from '../../lib/pages';
import { renderLocalizedDoc } from '../../lib/content';

const lang = 'ja' as const;

const page = await getNavPage('applicants');
const { Content } = await renderLocalizedDoc(lang, 'applicants');
---

<SubPageLayout {...navPageProps(page, lang)} lang={lang} clip>
  <div class="prose">
    {Content && <Content />}
  </div>
</SubPageLayout>

<style>
  /* Figma: Admission Page / Content */
  /* Markdown本文 (Figma: Section / ... , Template Card, QA List)。サイズは型ランプの変数 (--type-*) を参照 */
  .prose :global(h2) {
    margin: 56px 0 12px;
    color: var(--color-navy);
    font-size: var(--type-section-size);
    font-weight: 700;
    line-height: var(--type-section-leading);
  }

  .prose :global(p) {
    margin: 0 0 1em;
    color: var(--color-text-muted);
    font-size: var(--type-body-size);
    font-weight: 400;
    line-height: var(--type-body-leading);
    overflow-wrap: anywhere;
    white-space: pre-line; /* 原稿の改行を保つ */
  }

  /* 冒頭はFigmaでは見出しでなく本文リード（Body/Emphasis = .t-emphasis） */
  .prose > :global(p:first-child) {
    margin: 0;
    color: var(--color-text);
    font-size: var(--type-emphasis-size);
    font-weight: 500;
  }

  /* 連絡先メールは独立した強調行、注記は Caption */
  .prose :global(p > strong:only-child) {
    color: var(--color-text);
    font-size: var(--type-item-size);
    font-weight: 700;
    line-height: var(--type-item-leading);
  }

  /* 「研究室が望む学生」は項目の間に空行1行分（Figma: Body/Default の空行） */
  .prose :global(.wish-list p) {
    margin-bottom: 1.8em;
  }

  .prose :global(.wish-list p:last-child) {
    margin-bottom: 0;
  }

  .prose :global(p.note) {
    color: var(--color-text-subtle);
    font-size: var(--type-caption-size);
    line-height: var(--type-caption-leading);
  }

  .prose :global(ol),
  .prose :global(ul) {
    margin: 0 0 1em;
    padding: 0;
    color: var(--color-text);
    font-size: var(--type-body-size);
    line-height: var(--type-body-leading);
  }

  /* Figma: Template Card */
  .prose :global(ol) {
    display: flex;
    flex-direction: column;
    gap: 16px;
    padding: 24px;
    list-style-position: inside;
    background: var(--color-surface);
    border-radius: 8px;
  }

  .prose :global(li) {
    white-space: pre-line;
  }

  /* QA リスト（.qa-list）の見た目は BaseLayout の共通スタイル。答えの段落の余白だけ、上の .prose p より優先させる */
  .prose :global(.qa-item p) {
    margin: 6px 0 0;
  }
</style>
