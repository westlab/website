---
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import PageContent from '../../components/PageContent.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import { getNavPage } from '../../lib/pages';
import { getLocalizedDoc } from '../../lib/content';

const lang = 'ja' as const;

const page = await getNavPage('applicants');
const doc = await getLocalizedDoc('pagesContent', lang, 'applicants');
const { Content } = doc ? await render(doc) : { Content: null };
---

<BaseLayout title={page.data.title_ja} description={page.data.meta_description_ja ?? page.data.description_ja} lang={lang}>
  <PageHero title={page.data.title_ja} image={page.data.image} />
  <PageContent clip mobileBottom={56}>
    <Breadcrumb lang={lang} />
    <div class="body">
      <div class="prose">
        {Content && <Content />}
      </div>
    </div>
  </PageContent>
</BaseLayout>

<style>
  /* Figma: Admission Page / Content */
  /* パンくずの下の本文。セクション間の間隔はここで持つ（Figma: Main > Body） */
  .body {
    display: flex;
    flex-direction: column;
    gap: 56px;
  }

  /* Markdown本文 (Figma: Section / ... , Template Card, QA List)。サイズは型ランプの変数 (--type-*) を参照 */
  .prose :global(h2) {
    margin: 56px 0 12px;
    color: var(--color-navy);
    font-size: var(--type-section-size);
    font-weight: 700;
    line-height: var(--type-section-leading);
  }

  .prose :global(p) {
    margin: 0 0 1em;
    color: var(--color-text-muted);
    font-size: var(--type-body-size);
    font-weight: 400;
    line-height: var(--type-body-leading);
    overflow-wrap: anywhere;
    white-space: pre-line; /* 原稿の改行を保つ */
  }

  /* 冒頭はFigmaでは見出しでなく本文リード（Body/Emphasis = .t-emphasis） */
  .prose :global(p:first-child) {
    margin: 0;
    color: var(--color-text);
    font-size: var(--type-emphasis-size);
    font-weight: 500;
  }

  /* 連絡先メールは独立した強調行、注記は Caption */
  .prose :global(p > strong:only-child) {
    color: var(--color-text);
    font-weight: 700;
  }

  .prose :global(p.note) {
    color: var(--color-text-subtle);
    font-size: var(--type-caption-size);
    line-height: var(--type-caption-leading);
  }

  .prose :global(ol),
  .prose :global(ul) {
    margin: 0 0 1em;
    padding: 0;
    color: var(--color-text);
    font-size: var(--type-body-size);
    line-height: var(--type-body-leading);
  }

  /* Figma: Template Card */
  .prose :global(ol) {
    display: flex;
    flex-direction: column;
    gap: 16px;
    padding: 24px;
    list-style-position: inside;
    background: var(--color-surface);
    border-radius: 8px;
  }

  .prose :global(li) {
    white-space: pre-line;
  }

  /* Figma: QA Item / QA List（研究ページ「過去の研究」と同じ） */
  .prose :global(.qa-list) {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .prose :global(.qa-item) {
    padding-bottom: 6px;
    border-bottom: 1.5px solid var(--color-navy-divider);
  }

  .prose :global(.qa-item summary) {
    display: flex;
    align-items: center;
    gap: 12px;
    color: var(--color-text);
    font-size: var(--type-item-size);
    font-weight: 700;
    line-height: var(--type-item-leading);
    cursor: pointer;
    list-style: none;
  }

  .prose :global(.qa-item summary::-webkit-details-marker) {
    display: none;
  }

  .prose :global(.qa-item summary span) {
    flex: 1;
    min-width: 0;
  }

  .prose :global(.qa-item summary::after) {
    content: '';
    flex: none;
    width: 20px;
    height: 20px;
    background: url('/images/ui/icon-chevron-down.svg') center / contain no-repeat;
    transition: transform 0.2s ease;
  }

  .prose :global(.qa-item[open] summary::after) {
    transform: rotate(180deg);
  }

  .prose :global(.qa-item p) {
    margin: 6px 0 0;
  }
</style>
