---
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import SideBand from '../../components/SideBand.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import { getNavPage } from '../../lib/pages';
import { getLocalizedDoc } from '../../lib/content';

const lang = 'ja' as const;

const page = await getNavPage('applicants');
const doc = await getLocalizedDoc('pagesContent', lang, 'applicants');
const { Content } = doc ? await render(doc) : { Content: null };
---

<BaseLayout title={page.data.title_ja} description={page.data.meta_description_ja ?? page.data.description_ja} lang={lang}>
  <PageHero title={page.data.title_ja} image={page.data.image} />
  <section class="content">
    <SideBand />
    <div class="main">
      <Breadcrumb lang={lang} />
      <div class="body">
        <div class="prose">
          {Content && <Content />}
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* Figma: Admission Page / Content */
  .content {
    position: relative;
    padding: 64px var(--gutter) 96px;
    overflow: hidden;
  }

  .main {
    position: relative;
    max-width: 1200px;
    margin: 0 auto;
  }

  /* パンくずの下の本文。セクション間の間隔はここで持つ（Figma: Main > Body） */
  .body {
    display: flex;
    flex-direction: column;
    gap: 56px;
  }

  @media (max-width: 767px) {
    .content {
      padding-top: 32px;
      padding-bottom: 56px;
    }
  }

  /* Markdown本文 (Figma: Section / ... , Template Card, QA List)。サイズは型ランプ (.t-*) と同じ値 */
  .prose :global(h2) {
    margin: 56px 0 12px; /* .t-section */
    color: var(--color-navy);
    font-size: 28px;
    font-weight: 700;
    line-height: 1.5;
  }

  .prose :global(p) {
    margin: 0 0 1em;
    color: var(--color-text-muted);
    font-size: 16px; /* .t-body */
    font-weight: 400;
    line-height: 1.8;
    overflow-wrap: anywhere;
    white-space: pre-line; /* 原稿の改行を保つ */
  }

  /* 冒頭はFigmaでは見出しでなく本文リード（Body/Emphasis = .t-emphasis） */
  .prose > :global(p:first-child) {
    margin: 0;
    color: var(--color-text);
    font-size: 18px;
    font-weight: 500;
  }

  /* 連絡先メールは独立した強調行、注記は Caption */
  .prose :global(p > strong:only-child) {
    color: var(--color-text);
    font-size: 18px; /* .t-item */
    font-weight: 700;
    line-height: 1.7;
  }

  /* 「研究室が望む学生」は項目の間に空行1行分（Figma: Body/Default の空行） */
  .prose :global(.wish-list p) {
    margin-bottom: 1.8em;
  }

  .prose :global(.wish-list p:last-child) {
    margin-bottom: 0;
  }

  .prose :global(p.note) {
    color: var(--color-text-subtle);
    font-size: 14px; /* .t-caption */
    line-height: 1.7;
  }

  .prose :global(ol),
  .prose :global(ul) {
    margin: 0 0 1em;
    padding: 0;
    color: var(--color-text);
    font-size: 16px;
    line-height: 1.8;
  }

  /* Figma: Template Card */
  .prose :global(ol) {
    display: flex;
    flex-direction: column;
    gap: 16px;
    padding: 24px;
    list-style-position: inside;
    background: var(--color-surface);
    border-radius: 8px;
  }

  .prose :global(li) {
    white-space: pre-line;
  }

  /* Figma: QA Item / QA List（研究ページ「過去の研究」と同じ） */
  .prose :global(.qa-list) {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .prose :global(.qa-item) {
    padding-bottom: 6px;
    border-bottom: 1.5px solid rgba(0, 0, 123, 0.18);
  }

  .prose :global(.qa-item summary) {
    display: flex;
    align-items: center;
    gap: 12px;
    color: var(--color-text);
    font-size: 18px; /* .t-item */
    font-weight: 700;
    line-height: 1.7;
    cursor: pointer;
    list-style: none;
  }

  .prose :global(.qa-item summary::-webkit-details-marker) {
    display: none;
  }

  .prose :global(.qa-item summary span) {
    flex: 1;
    min-width: 0;
  }

  .prose :global(.qa-item summary::after) {
    content: '';
    flex: none;
    width: 20px;
    height: 20px;
    background: url('/images/ui/icon-chevron-down.svg') center / contain no-repeat;
    transition: transform 0.2s ease;
  }

  .prose :global(.qa-item[open] summary::after) {
    transform: rotate(180deg);
  }

  .prose :global(.qa-item p) {
    margin: 6px 0 0;
  }
</style>
