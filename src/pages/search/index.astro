---
// Figma: Search Results Page / Search Results Page (Mobile) / Search Results Page (0件)。
// 検索は Pagefind（ビルド時インデックス）をブラウザで実行する。
import BaseLayout from '../../layouts/BaseLayout.astro';
import SideBand from '../../components/SideBand.astro';
import { t } from '../../i18n/ui';

const lang = 'ja' as const;

const strings = {
  label: t(lang, 'search.label'),
  title: t(lang, 'search.title'),
  count: t(lang, 'search.count'),
  empty: t(lang, 'search.empty'),
  prompt: t(lang, 'search.prompt'),
  unavailable: t(lang, 'search.unavailable'),
  loading: t(lang, 'search.loading'),
  prev: t(lang, 'search.page.prev'),
  next: t(lang, 'search.page.next'),
  go: t(lang, 'search.page.go'),
};
---

<BaseLayout title={t(lang, 'search.label')} lang={lang} indexable={false}>
  <section class="search-header">
    <p class="label t-caption-label" id="search-label" hidden>{t(lang, 'search.label')}</p>
    <h1 class="t-h1" id="search-title">{t(lang, 'search.label')}</h1>
    <p class="count t-caption" id="search-count" role="status" aria-live="polite"></p>
    <form class="search-box" action="/search/" role="search">
      <img src="/images/ui/icon-search.svg" alt="" width="16" height="16" />
      <label class="visually-hidden" for="search-page-input">{t(lang, 'nav.search')}</label>
      <input id="search-page-input" class="t-ui" type="search" name="q" autocomplete="off" />
    </form>
  </section>

  <section class="content">
    <SideBand />
    <div class="main">
      <noscript><p class="message t-body">{t(lang, 'search.noscript')}</p></noscript>
      <p class="message t-body" id="search-message" hidden></p>
      <ol class="results" id="search-results"></ol>
      <nav class="pagination" id="search-pagination" aria-label={t(lang, 'search.page.nav')} hidden></nav>
    </div>
  </section>

  <script id="search-strings" type="application/json" set:html={JSON.stringify(strings)} />

  <!-- Vite を通すと動的 import に __VITE_PRELOAD__ が残って失敗するため、読み込みだけ is:inline で行う -->
  <script is:inline>
    window.__pagefind = import('/pagefind/pagefind.js').catch(() => null);
  </script>

  <script>
    const strings = JSON.parse(document.getElementById('search-strings')!.textContent!);
    const PER_PAGE = 10;
    const fmt = (s: string, v: Record<string, string | number>) =>
      s.replace(/\{(\w+)\}/g, (_, k) => String(v[k]));

    const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
    const titleEl = $('search-title');
    const countEl = $('search-count');
    const input = $<HTMLInputElement>('search-page-input');
    const messageEl = $('search-message');
    const listEl = $('search-results');
    const navEl = $('search-pagination');

    type Hit = { url: string; excerpt: string; meta: { title?: string } };
    type Pagefind = {
      search(q: string): Promise<{ results: { data(): Promise<Hit> }[] }>;
    };

    let pagefind: Pagefind | null = null;
    let token = 0;

    const params = () => new URLSearchParams(location.search);

    function message(text: string) {
      messageEl.textContent = text;
      messageEl.hidden = false;
    }

    function reset() {
      messageEl.hidden = true;
      listEl.replaceChildren();
      navEl.hidden = true;
      navEl.replaceChildren();
    }

    async function load(): Promise<Pagefind | null> {
      if (pagefind) return pagefind;
      pagefind = await (window as unknown as { __pagefind: Promise<Pagefind | null> }).__pagefind;
      return pagefind;
    }

    function pageHref(q: string, page: number) {
      const p = new URLSearchParams({ q });
      if (page > 1) p.set('page', String(page));
      return `/search/?${p}`;
    }

    function renderPagination(q: string, page: number, pages: number) {
      navEl.replaceChildren();
      if (pages <= 1) {
        navEl.hidden = true;
        return;
      }
      const chip = (label: string, target: number, opts: { current?: boolean; disabled?: boolean; aria?: string } = {}) => {
        const el = document.createElement(opts.disabled || opts.current ? 'span' : 'a');
        el.className = 'chip t-ui';
        el.textContent = label;
        if (opts.aria) el.setAttribute('aria-label', opts.aria);
        if (opts.current) {
          el.classList.add('current');
          el.setAttribute('aria-current', 'page');
        } else if (opts.disabled) {
          el.classList.add('disabled');
          el.setAttribute('aria-disabled', 'true');
        } else {
          (el as HTMLAnchorElement).href = pageHref(q, target);
          el.dataset.page = String(target);
        }
        navEl.append(el);
      };
      chip(strings.prev, page - 1, { disabled: page <= 1 });
      for (let n = 1; n <= pages; n++) {
        chip(String(n), n, { current: n === page, aria: fmt(strings.go, { n }) });
      }
      chip(strings.next, page + 1, { disabled: page >= pages });
      navEl.hidden = false;
    }

    async function run() {
      const q = (params().get('q') ?? '').trim();
      const page = Math.max(1, parseInt(params().get('page') ?? '1', 10) || 1);
      const my = ++token;
      input.value = q;
      reset();

      if (!q) {
        titleEl.textContent = strings.label;
        $('search-label').hidden = true;
        countEl.textContent = '';
        message(strings.prompt);
        return;
      }
      $('search-label').hidden = false;
      titleEl.textContent = fmt(strings.title, { q });
      document.title = `${titleEl.textContent} | 西研究室`;
      countEl.textContent = strings.loading;

      const pf = await load();
      if (my !== token) return;
      if (!pf) {
        countEl.textContent = '';
        message(strings.unavailable);
        return;
      }

      const search = await pf.search(q);
      if (my !== token) return;
      const total = search.results.length;
      if (total === 0) {
        countEl.textContent = fmt(strings.count, { n: 0 });
        message(fmt(strings.empty, { q }));
        return;
      }
      const pages = Math.ceil(total / PER_PAGE);
      const current = Math.min(page, pages);
      const hits = await Promise.all(
        search.results.slice((current - 1) * PER_PAGE, current * PER_PAGE).map((r) => r.data()),
      );
      if (my !== token) return;

      countEl.textContent = fmt(strings.count, { n: total });
      for (const hit of hits) {
        const li = document.createElement('li');
        li.className = 'item';
        const a = document.createElement('a');
        a.className = 'item-title t-h3';
        a.href = hit.url;
        a.textContent = hit.meta.title || hit.url;
        const p = document.createElement('p');
        p.className = 'excerpt t-caption';
        p.innerHTML = hit.excerpt; // Pagefind が本文を整形し、一致箇所を <mark> で囲む
        li.append(a, p);
        listEl.append(li);
      }
      renderPagination(q, current, pages);
    }

    navEl.addEventListener('click', (e) => {
      const a = (e.target as HTMLElement).closest<HTMLAnchorElement>('a[data-page]');
      if (!a || e.metaKey || e.ctrlKey || e.shiftKey || e.button !== 0) return;
      e.preventDefault();
      history.pushState(null, '', a.href);
      run().then(() => titleEl.scrollIntoView({ block: 'start' }));
    });
    window.addEventListener('popstate', run);
    run();
  </script>
</BaseLayout>

<style>
  /* Figma: Search Results Page / Search Header */
  .search-header {
    padding: 56px var(--gutter) 40px;
    max-width: calc(1200px + var(--gutter) * 2);
    margin: 0 auto;
  }

  .label {
    margin: 0 0 14px;
    color: var(--color-navy);
  }

  .label[hidden] {
    display: none;
  }

  h1 {
    margin: 0 0 14px;
    color: var(--color-text);
    overflow-wrap: anywhere;
  }

  .count {
    min-height: 24px;
    margin: 0 0 14px;
    color: var(--color-text-muted);
  }

  .search-box {
    display: flex;
    align-items: center;
    gap: 8px;
    width: 440px;
    max-width: 100%;
    height: 44px;
    padding: 0 16px;
    background: #fff;
    border: 1px solid var(--color-border-input);
    border-radius: 6px;
  }

  .search-box:focus-within {
    border-color: var(--color-navy);
  }

  .search-box img {
    flex: none;
  }

  .search-box input {
    min-width: 0;
    width: 100%;
    padding: 0;
    border: 0;
    outline: none;
    background: none;
    font-family: inherit;
    color: var(--color-text);
  }

  /* Figma: Content / Result List */
  .content {
    position: relative;
    padding: 48px var(--gutter) 64px;
    overflow: hidden;
  }

  .main {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 48px;
    max-width: 1200px;
    min-height: 240px;
    margin: 0 auto;
  }

  .message {
    margin: 0;
  }

  .results {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .results :global(.item) {
    padding: 16px 0;
    border-bottom: 1px solid var(--color-navy);
  }

  .results :global(.item:last-child) {
    border-bottom: 0;
  }

  .results :global(.item-title) {
    color: var(--color-navy);
    text-decoration: none;
    overflow-wrap: anywhere;
  }

  .results :global(.item-title:hover) {
    text-decoration: underline;
  }

  .results :global(.excerpt) {
    margin: 4px 0 0;
    color: var(--color-text-subtle);
    overflow-wrap: anywhere;
  }

  .results :global(mark) {
    background: none;
    color: var(--color-text);
    font-weight: 700;
  }

  /* Figma: Pagination */
  .pagination {
    display: flex;
    justify-content: center;
    gap: 8px;
  }

  .pagination[hidden],
  .message[hidden] {
    display: none;
  }

  .pagination :global(.chip) {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 36px;
    height: 36px;
    padding: 0 2px;
    color: var(--color-text-subtle);
    background: #fff;
    border: 1px solid var(--color-border-input);
    text-decoration: none;
  }

  .pagination :global(a.chip:hover) {
    border-color: var(--color-navy);
  }

  .pagination :global(.chip.current) {
    color: #fff;
    background: var(--color-navy);
    border-color: var(--color-navy);
    font-weight: 700;
  }

  .pagination :global(.chip.disabled) {
    color: var(--color-border-input);
  }

  /* Figma: Search Results Page (Mobile) */
  @media (max-width: 767px) {
    .search-header {
      padding-block: 24px;
    }

    .label,
    h1,
    .count {
      margin-bottom: 12px;
    }

    .content {
      padding-top: 8px;
      padding-bottom: 32px;
    }

    .pagination {
      flex-wrap: wrap;
      justify-content: flex-start;
    }
  }
</style>
