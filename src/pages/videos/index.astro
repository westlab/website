---
// Figma: Videos Page / Videos Page (Mobile)
// 遷移元は Header の「研究内容」ドロップダウン内「研究紹介動画」。Nav Card を持たない独立ページなので
// Page Title のタイトルは nav ラベルを使い、画像は pages.yaml（nav: false のレコード）から引く。
// サムネイルは動画サービス側から取得する想定のため、ここでは暗色の枠+再生アイコンで表示する。
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import SideBand from '../../components/SideBand.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import VideoCard from '../../components/VideoCard.astro';
import { getPageImage } from '../../lib/pages';
import { t } from '../../i18n/ui';

const lang = 'ja' as const;
const heroImage = await getPageImage('videos');

const site = (await getCollection('site'))[0];
const videos = (await getCollection('videos')).sort((a, b) => a.data.order - b.data.order);
const title = t(lang, 'nav.research.videos');
---

<BaseLayout title={title} description={site.data.page_descriptions.videos.ja} lang={lang}>
  <PageHero title={title} image={heroImage} />
  <div class="content">
    <SideBand />
    <div class="main">
      <Breadcrumb lang={lang} />
      <div class="body">
        <p class="t-body lead">{t(lang, 'videos.lead')}</p>
        {videos.map((video) => <VideoCard video={video.data} lang={lang} />)}
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .content {
    position: relative;
    padding: 64px var(--gutter) 96px;
  }

  .main {
    position: relative;
    max-width: 1200px;
    margin: 0 auto;
  }

  /* パンくずの下の本文。セクション間の間隔はここで持つ（Figma: Main > Body） */
  .body {
    display: flex;
    flex-direction: column;
    gap: 40px;
  }

  .lead {
    margin: 0;
  }

  @media (max-width: 767px) {
    .content {
      padding-top: 32px;
      padding-bottom: 32px;
    }
  }
</style>
