---
// Figma: Research Detail Page / Research Detail Page (Mobile)
// 研究トピックの詳細ページ（カードの「詳しく見る」の遷移先）。パンくず、本文、前後トピックへのリンク。
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import PageContent from '../../components/PageContent.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import { getLocalizedList } from '../../lib/content';
import { getPageImage } from '../../lib/pages';
import { t } from '../../i18n/ui';

export async function getStaticPaths() {
  // 前後リンクは front matter の order 順
  const topics = (await getLocalizedList('research', 'ja')).sort((a, b) => a.data.order - b.data.order);
  return topics.map((topic, i) => ({
    params: { slug: topic.slug },
    props: { topic, prev: topics[i - 1], next: topics[i + 1] },
  }));
}

const lang = 'ja' as const;
const { topic, prev, next } = Astro.props;
const { Content } = await render(topic);
// トピックごとの Page Title 画像（pages.yaml の research/<slug>）
const heroImage = await getPageImage(`research/${topic.slug}`);
const href = (slug: string) => `/research/${slug}/`;
---

<BaseLayout title={topic.data.title} description={topic.data.description ?? topic.data.summary} ogType="article" lang={lang}>
  <PageHero title={topic.data.title} image={heroImage} />
  <PageContent maxWidth="900px" mobileTop={40} mobileBottom={40}>
    <Breadcrumb lang={lang} current={{ label: topic.data.title, href: href(topic.slug) }} />
    <div class="body">
      <article class="article">
        <Content />
      </article>
      <nav class="pager" aria-label={t(lang, 'research.pager.label')}>
        {prev && (
          <a class="pager-link prev" href={href(prev.slug)} rel="prev">
            <span class="label t-ui-small-bold"><span aria-hidden="true">← </span>{t(lang, 'research.pager.prev')}</span>
            <span class="title t-item">{prev.data.title}</span>
          </a>
        )}
        {next && (
          <a class="pager-link next" href={href(next.slug)} rel="next">
            <span class="label t-ui-small-bold">{t(lang, 'research.pager.next')}<span aria-hidden="true"> →</span></span>
            <span class="title t-item">{next.data.title}</span>
          </a>
        )}
      </nav>
    </div>
  </PageContent>
</BaseLayout>

<style>
  /* パンくずの下の本文。セクション間の間隔はここで持つ（Figma: Main > Body） */
  .body {
    display: flex;
    flex-direction: column;
    gap: 40px;
  }

  .article :global(h1) {
    margin: 0 0 20px;
    font-size: var(--type-section-size);
    font-weight: 700;
    line-height: var(--type-section-leading);
    color: var(--color-navy);
  }

  .article :global(h2) {
    margin: 40px 0 12px;
    font-size: var(--type-subsection-size);
    font-weight: 700;
    line-height: var(--type-subsection-leading);
    color: var(--color-navy);
  }

  .article :global(p) {
    margin: 0 0 16px;
  }

  /* 長い DOI や URL のリンクは 320px 幅で本文からはみ出すので、リンクだけ折り返す（日本語の改行位置は変えない） */
  .article :global(a) {
    overflow-wrap: anywhere;
  }

  /* 画像は本文幅いっぱいにせず、上限サイズで中央に置く（キャプションは remark-figure が alt から生成） */
  .article :global(figure) {
    margin: 32px 0;
    text-align: center;
  }

  .article :global(img) {
    width: auto;
    max-width: min(100%, 640px);
    height: auto;
    max-height: 420px;
    margin: 0 auto;
    border-radius: 8px;
  }

  .article :global(figcaption) {
    margin-top: 8px;
    font-size: var(--type-caption-size);
    line-height: var(--type-caption-leading);
    color: var(--color-text-muted);
  }

  /* 本文先頭の要素の上余白はパンくずの24pxに、末尾の下余白は .body の gap に任せる */
  .article > :global(:first-child) {
    margin-top: 0;
  }

  .article > :global(:last-child) {
    margin-bottom: 0;
  }

  .pager {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 24px;
    padding-top: 40px;
    border-top: 1.5px solid var(--color-navy-divider);
  }

  .pager-link {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 24px;
    border-radius: 16px;
    background: var(--color-surface-card);
    color: var(--color-text);
    text-decoration: none;
    transition: box-shadow 0.2s ease, transform 0.2s ease;
  }

  .pager-link:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 24px var(--color-navy-shadow);
  }

  .pager-link.next {
    grid-column: 2;
    align-items: flex-end;
    text-align: right;
  }

  .label {
    color: var(--color-navy);
  }

  @media (max-width: 767px) {
    .pager {
      grid-template-columns: 1fr;
      gap: 16px;
    }

    .pager-link {
      padding: 20px;
    }

    .pager-link.next {
      grid-column: auto;
    }
  }
</style>
