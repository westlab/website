---
// Figma: Research Page / Research Page (Mobile)
import SubPageLayout from '../../layouts/SubPageLayout.astro';
import ResearchTopicCard from '../../components/ResearchTopicCard.astro';
import { getLocalizedList, getSortedCollection, renderLocalizedDoc } from '../../lib/content';
import { getNavPage, navPageProps } from '../../lib/pages';
import { t } from '../../i18n/ui';

const lang = 'ja' as const;

const page = await getNavPage('research');

const { doc: intro, Content: IntroContent } = await renderLocalizedDoc(lang, 'research-intro');
const topics = await getLocalizedList('research', lang);
const pastResearch = await getSortedCollection('pastResearch');
---

<SubPageLayout {...navPageProps(page, lang)} title={t(lang, 'nav.research.about')} lang={lang} tabletBottom={80} mobileTop={40}>
  <section class="block intro">
    <h2 class="t-section">{intro?.data.title}</h2>
    {IntroContent && <IntroContent />}
  </section>

  <section class="block">
    <h2 class="t-section">{t(lang, 'research.topics.title')}</h2>
    <p class="t-body">{t(lang, 'research.topics.lead')}</p>
  </section>

  <div class="topics-grid">
    {topics.map((topic) => <ResearchTopicCard topic={topic} lang={lang} />)}
  </div>

  <section class="block past">
    <h2 class="t-section">{t(lang, 'research.past.title')}</h2>
    <p class="t-body">{t(lang, 'research.past.lead')}</p>
    <div class="qa-list">
      {pastResearch.map((item) => (
        <details class="qa-item">
          <summary><span>{item.data.title_ja}</span></summary>
          <p class="t-body">{item.data.body_ja}</p>
        </details>
      ))}
    </div>
  </section>
</SubPageLayout>

<style>
  .block {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .block h2,
  .block p {
    margin: 0;
  }

  .block h2 {
    color: var(--color-navy);
  }

  .intro :global(p) {
    margin: 0;
  }

  .topics-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 32px 24px;
  }

  .past {
    gap: 12px;
  }

  @media (max-width: 767px) {
    .topics-grid {
      grid-template-columns: 1fr;
      gap: 16px;
    }

    /* Figma はカード2枚ごとの行間が32px（行内は16px） */
    .topics-grid > :nth-child(2n + 3) {
      margin-top: 16px;
    }
  }
</style>
