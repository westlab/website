---
import { getSortedCollection } from '../../lib/content';
import SubPageLayout from '../../layouts/SubPageLayout.astro';
import { getNavPage, navPageProps } from '../../lib/pages';

const lang = 'ja' as const;

const page = await getNavPage('links');
const categories = await getSortedCollection('links');
---

<SubPageLayout {...navPageProps(page, lang)} lang={lang} clip>
  {categories.map((category) => (
    <div class="category">
      <h2 class="t-section">{category.data.category_ja}</h2>
      <ul class="t-body">
        {category.data.items.map((item) => (
          <li>
            {item.url ? (
              <a href={item.url} target="_blank" rel="noopener">{item.label}</a>
            ) : (
              <span class="plain">{item.label}</span>
            )}
          </li>
        ))}
      </ul>
    </div>
  ))}
</SubPageLayout>

<style>
  /* Figma: Links Page / Content */
  .category {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  h2 {
    margin: 0;
    color: var(--color-navy);
  }

  ul {
    display: flex;
    flex-direction: column;
    gap: 10px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  li {
    overflow-wrap: anywhere;
  }

  li::before {
    content: '→ ';
    color: var(--color-navy);
  }

  a {
    color: var(--color-navy);
    text-decoration: none;
  }

  a:hover {
    text-decoration: underline;
  }

  /* url なし: リンクではないミュート色のテキスト（Figma Links Page / 講義） */
  .plain {
    color: var(--color-text-muted);
  }

</style>
