---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import BackToTop from '../components/BackToTop.astro';
import { t, type Lang } from '../i18n/ui';

interface Props {
  title: string;
  // 検索結果・SNS共有に出る要約。各ページのデータ層から渡す
  description: string;
  // 記事ページなどは 'article' を渡す
  ogType?: 'website' | 'article';
  lang?: Lang;
  /** false なら Pagefind と検索エンジンの対象外にする（検索ページ・404） */
  indexable?: boolean;
}

const { title, description, ogType = 'website', lang = 'ja', indexable = true } = Astro.props;
const fullTitle = `${title} | 西研究室`;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/images/logo/westlabicon.png" type="image/png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@400;500;700&display=swap"
    />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {!indexable && <meta name="robots" content="noindex" />}
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="西研究室" />
  </head>
  <body>
    <a class="skip-link t-ui-bold" href="#main">{t(lang, 'nav.skip')}</a>
    <Header lang={lang} />
    <main id="main" tabindex="-1" data-pagefind-body={indexable ? '' : undefined}>
      <slot />
    </main>
    <Footer lang={lang} />
    <BackToTop lang={lang} />
  </body>
</html>

<style is:global>
  /* Figma のカラー・余白。値はFigmaファイル（Lu56izrHxvrpBLblm9kSPo）に合わせる */
  :root {
    color-scheme: light;

    --color-navy: #00007b;
    --color-accent: #0000f5;
    --color-text: #26262e;
    --color-text-muted: #54545a;
    --color-text-subtle: #727278;
    --color-border: #e5e5eb;
    --color-border-input: #bfc4d1;
    --color-placeholder: #999eab;
    --color-surface: #f5f7fa;
    --color-surface-strong: #f0f2f7;
    --color-hero-text: #d9def2;
    --color-hero-bg: #050817;
    --color-blue-medium: #2c4faf;
    --color-surface-card: #f8f8fa;
    --color-video-bg: #171a24;
    /* --color-navy の透明度違い（影・区切り線・枠線・補助テキスト） */
    --color-navy-faint: rgba(0, 0, 123, 0.12);
    --color-navy-divider: rgba(0, 0, 123, 0.18);
    --color-navy-border: rgba(0, 0, 123, 0.25);
    --color-navy-muted: rgba(0, 0, 123, 0.6);

    /* 型ランプ（.t-*）のサイズと行間。class を付けられない要素（Markdown 本文など）はここを参照する */
    --type-display-hero-size: 78px;
    --type-display-hero-leading: 1.15;
    --type-display-page-title-size: 64px;
    --type-display-page-title-leading: 1.2;
    --type-section-size: 28px;
    --type-section-leading: 1.5;
    --type-subsection-size: 22px;
    --type-subsection-leading: 1.6;
    --type-item-size: 18px;
    --type-item-leading: 1.7;
    --type-card-title-size: 40px;
    --type-card-title-leading: 1.3;
    --type-lead-size: 28px;
    --type-lead-leading: 1.6;
    --type-body-size: 16px;
    --type-body-leading: 1.8;
    --type-emphasis-size: 18px;
    --type-emphasis-leading: 1.8;
    --type-caption-size: 14px;
    --type-caption-leading: 1.7;
    --type-caption-label-size: 16px;
    --type-caption-label-leading: 1.6;
    --type-ui-size: 16px;
    --type-ui-leading: 1.4;
    --type-ui-bold-size: 16px;
    --type-ui-bold-leading: 1.4;
    --type-ui-small-size: 14px;
    --type-ui-small-leading: 1.4;
    --type-ui-small-bold-size: 14px;
    --type-ui-small-bold-leading: 1.4;
    --type-icon-glyph-size: 20px;
    --type-icon-glyph-leading: 1;

    --gutter: 120px;
    --header-height: 72px;
  }

  @media (max-width: 1023px) {
    :root {
      --gutter: 40px;
      --header-height: 64px;
    }
  }

  @media (max-width: 767px) {
    :root {
      --gutter: 20px;
      --type-display-hero-size: 40px;
      --type-display-hero-leading: 1.2;
      --type-display-page-title-size: 40px;
      --type-display-page-title-leading: 1.2;
    }
  }

  /* $k$ などの変数。Noto Sans JP には斜体がないので、数式らしい欧文セリフ体の斜体にする */
  var {
    font-family: 'Times New Roman', Times, serif;
    font-style: italic;
  }

  * {
    box-sizing: border-box;
  }

  html {
    scroll-padding-top: var(--header-height);
  }

  body {
    margin: 0;
    background: #fff;
    font-family: 'Noto Sans JP', 'Hiragino Sans', sans-serif;
    font-size: var(--type-body-size);
    line-height: var(--type-body-leading);
    color: var(--color-text-muted);
  }

  main {
    overflow-x: clip;
  }

  img {
    max-width: 100%;
    display: block;
  }

  /*
   * Figma のテキストスタイルと1対1で対応するクラス（figma-type-system スキルの型ランプ）。
   * サイズと行間を変えるときは個々の要素ではなく、上の --type-*-size / --type-*-leading を直す。
   * 見出しの3段（.t-section / .t-subsection / .t-item）は見た目の名前で、HTML の見出しレベルとは別。
   */
  .t-display-hero { font-size: var(--type-display-hero-size); font-weight: 700; line-height: var(--type-display-hero-leading); }
  .t-display-page-title { font-size: var(--type-display-page-title-size); font-weight: 700; line-height: var(--type-display-page-title-leading); }
  .t-section { font-size: var(--type-section-size); font-weight: 700; line-height: var(--type-section-leading); }
  .t-subsection { font-size: var(--type-subsection-size); font-weight: 700; line-height: var(--type-subsection-leading); }
  .t-item { font-size: var(--type-item-size); font-weight: 700; line-height: var(--type-item-leading); }
  .t-card-title { font-size: var(--type-card-title-size); font-weight: 700; line-height: var(--type-card-title-leading); }
  .t-lead { font-size: var(--type-lead-size); font-weight: 400; line-height: var(--type-lead-leading); }
  .t-body { font-size: var(--type-body-size); font-weight: 400; line-height: var(--type-body-leading); }
  .t-emphasis { font-size: var(--type-emphasis-size); font-weight: 500; line-height: var(--type-emphasis-leading); }
  .t-caption { font-size: var(--type-caption-size); font-weight: 400; line-height: var(--type-caption-leading); }
  .t-caption-label { font-size: var(--type-caption-label-size); font-weight: 700; line-height: var(--type-caption-label-leading); }
  .t-ui { font-size: var(--type-ui-size); font-weight: 500; line-height: var(--type-ui-leading); }
  .t-ui-bold { font-size: var(--type-ui-bold-size); font-weight: 700; line-height: var(--type-ui-bold-leading); }
  .t-ui-small { font-size: var(--type-ui-small-size); font-weight: 500; line-height: var(--type-ui-small-leading); }
  .t-ui-small-bold { font-size: var(--type-ui-small-bold-size); font-weight: 700; line-height: var(--type-ui-small-bold-leading); }
  .t-icon-glyph { font-size: var(--type-icon-glyph-size); font-weight: 700; line-height: var(--type-icon-glyph-leading); }

  /* キーボード操作用。フォーカスされたときだけ左上に現れる */
  .skip-link {
    position: fixed;
    left: 16px;
    top: 8px;
    z-index: 200;
    padding: 10px 16px;
    border-radius: 6px;
    background: var(--color-navy);
    color: #fff;
    text-decoration: none;
    transform: translateY(-200%);
  }

  .skip-link:focus {
    transform: none;
  }

  /* キーボードフォーカスの輪郭（マウス操作では出さない） */
  :focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }

  .skip-link:focus-visible {
    outline-color: #fff;
  }

  main:focus {
    outline: none;
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }
</style>
