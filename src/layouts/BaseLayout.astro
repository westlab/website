---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import BackToTop from '../components/BackToTop.astro';
import { t, type Lang } from '../i18n/ui';

interface Props {
  title: string;
  lang?: Lang;
  /** false なら検索インデックスに含めない（検索ページ自身など） */
  indexable?: boolean;
}

const { title, lang = 'ja', indexable = true } = Astro.props;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/images/logo/westlabicon.png" type="image/png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@400;500;700&display=swap"
    />
    <title>{title} | 西研究室</title>
  </head>
  <body>
    <a class="skip-link t-ui-bold" href="#main">{t(lang, 'nav.skip')}</a>
    <Header lang={lang} />
    <main id="main" tabindex="-1" data-pagefind-body={indexable ? '' : undefined}>
      <slot />
    </main>
    <Footer lang={lang} />
    <BackToTop lang={lang} />
  </body>
</html>

<style is:global>
  /* Figma のカラー・余白。値はFigmaファイル（Lu56izrHxvrpBLblm9kSPo）に合わせる */
  :root {
    color-scheme: light;

    --color-navy: #00007b;
    --color-accent: #0000f5;
    --color-text: #26262e;
    --color-text-muted: #54545a;
    --color-text-subtle: #727278;
    --color-border: #e5e5eb;
    --color-border-input: #bfc4d1;
    --color-placeholder: #999eab;
    --color-surface: #f5f7fa;
    --color-surface-strong: #f0f2f7;
    --color-hero-text: #d9def2;
    --color-hero-bg: #050817;

    --gutter: 120px;
    --header-height: 72px;
  }

  @media (max-width: 1023px) {
    :root {
      --gutter: 40px;
      --header-height: 64px;
    }
  }

  @media (max-width: 767px) {
    :root {
      --gutter: 20px;
    }
  }

  /* $k$ などの変数。Noto Sans JP には斜体がないので、数式らしい欧文セリフ体の斜体にする */
  var {
    font-family: 'Times New Roman', Times, serif;
    font-style: italic;
  }

  * {
    box-sizing: border-box;
  }

  html {
    scroll-padding-top: var(--header-height);
  }

  body {
    margin: 0;
    background: #fff;
    font-family: 'Noto Sans JP', 'Hiragino Sans', sans-serif;
    font-size: 16px;
    line-height: 1.8;
    color: var(--color-text-muted);
  }

  main {
    overflow-x: clip;
  }

  img {
    max-width: 100%;
    display: block;
  }

  /*
   * Figma のテキストスタイルと1対1で対応するクラス（figma-type-system スキルの型ランプ）。
   * サイズを変えるときは個々の要素ではなくここを直す。
   */
  .t-display-hero { font-size: 78px; font-weight: 700; line-height: 1.15; }
  .t-display-page-title { font-size: 64px; font-weight: 700; line-height: 1.2; }
  .t-h1 { font-size: 28px; font-weight: 700; line-height: 1.5; }
  .t-h2 { font-size: 22px; font-weight: 700; line-height: 1.6; }
  .t-h3 { font-size: 18px; font-weight: 700; line-height: 1.7; }
  .t-card-title { font-size: 40px; font-weight: 700; line-height: 1.3; }
  .t-lead { font-size: 28px; font-weight: 400; line-height: 1.6; }
  .t-body { font-size: 16px; font-weight: 400; line-height: 1.8; }
  .t-emphasis { font-size: 18px; font-weight: 500; line-height: 1.8; }
  .t-caption { font-size: 14px; font-weight: 400; line-height: 1.7; }
  .t-caption-label { font-size: 16px; font-weight: 700; line-height: 1.6; }
  .t-ui { font-size: 16px; font-weight: 500; line-height: 1.4; }
  .t-ui-bold { font-size: 16px; font-weight: 700; line-height: 1.4; }
  .t-ui-small { font-size: 14px; font-weight: 500; line-height: 1.4; }
  .t-ui-small-bold { font-size: 14px; font-weight: 700; line-height: 1.4; }
  .t-icon-glyph { font-size: 20px; font-weight: 700; line-height: 1; }

  @media (max-width: 767px) {
    .t-display-hero,
    .t-display-page-title { font-size: 40px; line-height: 1.2; }
  }

  /* キーボード操作用。フォーカスされたときだけ左上に現れる */
  .skip-link {
    position: fixed;
    left: 16px;
    top: 8px;
    z-index: 200;
    padding: 10px 16px;
    border-radius: 6px;
    background: var(--color-navy);
    color: #fff;
    text-decoration: none;
    transform: translateY(-200%);
  }

  .skip-link:focus {
    transform: none;
  }

  /* キーボードフォーカスの輪郭（マウス操作では出さない） */
  :focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }

  .skip-link:focus-visible {
    outline-color: #fff;
  }

  main:focus {
    outline: none;
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }
</style>
