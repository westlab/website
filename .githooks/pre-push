#!/bin/sh
# push前に ja/en 翻訳の同期状況と、YAML の値が一覧の範囲内かを警告表示する（ブロックはしない）。
node scripts/check-data-values.mjs

zero="0000000000000000000000000000000000000000"

while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = "$zero" ] && continue # ブランチ削除は対象外
  node scripts/check-translations.mjs "$remote_sha" "$local_sha"
done

exit 0
